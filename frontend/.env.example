# =================================================================
# ShopSphere Multi-Vendor Marketplace Frontend Environment Variables
# =================================================================

# Backend API Base URL
# - In local development: use /api/v1 (requests will proxy via Vite dev server to http://localhost:5000)
# - In production (e.g. Vercel deployment): set to your deployed backend URL:
#   Example: VITE_API_URL=https://shopsphere-api.onrender.com/api/v1
VITE_API_URL=/api/v1

# Payment Gateway Public Key (Razorpay test key for customer checkout)
VITE_RAZORPAY_KEY_ID=rzp_test_12345

# Application Branding & Metadata
VITE_APP_NAME=ShopSphere
