# =================================================================
# ShopSphere Multi-Vendor Marketplace Backend Environment Variables
# =================================================================

# -----------------------------------------------------------------
# 1. SERVER CONFIGURATION
# -----------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Frontend Client URL(s) for CORS validation
# In development: http://localhost:5173
# In production: comma-separated list of your allowed frontend domains
# Example: https://shopsphere.vercel.app,https://admin.shopsphere.com
CLIENT_URL=http://localhost:5173

# Set to true when hosting behind a reverse proxy (Render, Railway, Fly.io, Cloudflare)
# Required for secure cookies and accurate rate-limiting IP resolution
TRUST_PROXY=true

# -----------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas or Local MongoDB)
# -----------------------------------------------------------------
# Example MongoDB Atlas URI:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.pfx4e4f.mongodb.net/shopsphere?retryWrites=true&w=majority
# Example Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/shopsphere

# Optional DNS SRV resolution flag (useful on specific Windows networks)
ENABLE_CUSTOM_DNS=false

# -----------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT & Cookies)
# -----------------------------------------------------------------
# Generate high-entropy keys using: openssl rand -base64 32
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRY=15m

JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_REFRESH_EXPIRY=7d

# Cookie Security Settings:
# - In production cross-domain setups (e.g., frontend on Vercel, backend on Render):
#   Set COOKIE_SAME_SITE=none and COOKIE_SECURE=true
# - In local development:
#   Set COOKIE_SAME_SITE=lax and COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# -----------------------------------------------------------------
# 4. MEDIA UPLOAD (Cloudinary - Optional for Staging/Demo)
# -----------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay / Stripe)
# -----------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# -----------------------------------------------------------------
# 6. SMS & OTP PROVIDER
# -----------------------------------------------------------------
# Options: DEVELOPMENT_MOCK | TWILIO | FAST2SMS
SMS_PROVIDER=DEVELOPMENT_MOCK
SMS_API_KEY=your_sms_api_key_if_applicable
SMS_SENDER_ID=SHOPSPH
TWILIO_ACCOUNT_SID=your_twilio_sid_if_applicable
TWILIO_AUTH_TOKEN=your_twilio_token_if_applicable

# -----------------------------------------------------------------
# 7. AI ASSISTANT ENGINE
# -----------------------------------------------------------------
AI_API_KEY=mock_ai_key_for_development
